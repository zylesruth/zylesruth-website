# Copy this file to .env for local dev, and add the same values in
# Vercel → Project Settings → Environment Variables for production.

# Contact form: get a free access key at https://web3forms.com (email only, no account needed)
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Blog CMS (/admin): GitHub OAuth App credentials.
# Create at https://github.com/settings/developers > New OAuth App
#   Homepage URL: https://www.zylesruth.com
#   Authorization callback URL: https://www.zylesruth.com/api/callback
# OAUTH_GITHUB_CLIENT_SECRET is server-only — never expose it with a PUBLIC_ prefix.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
