---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Layout title="Blog" description="Ongoing thoughts, in progress.">
  <PageHero eyebrow="Writing" title="Blog" intro="Notes and essays, published as they're ready." />

  <section class="mx-auto max-w-2xl px-6 pb-24">
    <div class="divide-y divide-line">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block py-7 first:pt-0">
            <p class="text-xs font-medium uppercase tracking-widest text-ink-soft">
              {dateFormat.format(post.data.date)}
            </p>
            <h2 class="mt-2 font-display text-2xl font-semibold text-ink transition-colors group-hover:text-rust">
              {post.data.title}
            </h2>
            <p class="mt-2 leading-relaxed text-ink-soft">{post.data.description}</p>
            <span class="mt-3 inline-flex items-center text-sm font-medium text-rust opacity-0 transition-opacity group-hover:opacity-100">
              Read →
            </span>
          </a>
        ))
      }
      {posts.length === 0 && <p class="py-10 text-ink-soft">No posts yet — check back soon.</p>}
    </div>
  </section>
</Layout>
