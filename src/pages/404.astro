---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <section class="mx-auto flex max-w-lg flex-col items-center px-6 py-32 text-center">
    <p class="font-display text-6xl font-semibold text-rust">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-ink">Page not found</h1>
    <p class="mt-3 text-ink-soft">The page you're looking for doesn't exist, or has moved.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-ink px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-rust"
    >
      Back to home
    </a>
  </section>
</Layout>
