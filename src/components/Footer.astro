---
import { site, nav } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-cream-100">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-display text-lg font-semibold text-ink">{site.name}</p>
      <p class="mt-1 max-w-xs text-sm text-ink-soft">{site.tagline}</p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:gap-10">
      <div class="flex flex-col gap-1.5 text-sm">
        {
          nav.slice(0, 4).map((item) => (
            <a href={item.href} class="text-ink-soft transition-colors hover:text-rust">
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-1.5 text-sm">
        {
          site.social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-ink-soft transition-colors hover:text-rust">
              {s.label}
            </a>
          ))
        }
        <a href={`mailto:${site.email}`} class="text-ink-soft transition-colors hover:text-rust">
          {site.email}
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-line px-6 py-4 text-center text-xs text-ink-soft/80">
    © {year} {site.name}. All rights reserved.
  </div>
</footer>
