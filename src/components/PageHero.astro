---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<div class="mx-auto max-w-3xl px-6 pt-16 pb-10 text-center sm:pt-20">
  {eyebrow && <p class="text-sm font-medium uppercase tracking-widest text-rust">{eyebrow}</p>}
  <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
    {title}
  </h1>
  {intro && <p class="mx-auto mt-4 max-w-xl text-lg text-ink-soft">{intro}</p>}
</div>
